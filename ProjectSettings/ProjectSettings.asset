%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!129 &1
PlayerSettings:
  m_ObjectHideFlags: 0
  serializedVersion: 26
  productGUID: 8f4b7c2e9a1d4e6fb3c5d7e9f0a2b4c6
  AndroidProfiler: 0
  companyName: DefaultCompany
  productName: How to Fish
  defaultCursor: {fileID: 0}
  cursorHotspot: {x: 0, y: 0}
  m_ShowUnitySplashScreen: 0
  m_ShowUnitySplashLogo: 0
  m_ShowUnitySplashLogoWithScript: 0
  WebGLMemorySize: 512
  # WebGL 异常支持 = Full(2)。AssetRipper 生成的这份 ProjectSettings 里
  # 没写这个字段，Unity 默认 Off(0)：C# 异常不带调用栈，wasm 崩溃只给
  # "null function / wasm-function[N]" 这种无符号栈，没法定位。
  # Full 模式下 IL2CPP 会把 C# 调用栈嵌进异常文本打到 console.error，
  # 是把 wasm 层崩溃翻回 C# 方法名的唯一手段（代价：wasm 略大略慢，
  # 诊断期间可接受；定位完成后可改回）。
  webGLEnableExceptions: 2
  webGLPowerPreference: 0
  webGLForceLinearFilter: 0
  webGLMemoryGrowthMode: 2
  webGLMemoryLinearGrowthStep: 16
  webGLMemoryGeometricGrowthStep: 0.2
  webGLMemoryGeometricGrowthCap: 96
  webGLPowerPreferenceMobile: 0
  webGLRequireES31: 0
  webGLWebAssemblyBigInt: 0
  webGLInitialMemorySize: 32
  webGLMaximumMemorySize: 2048
  webGLMemoryPinnedSize: 128
  webGLDecompressionFallback: 0
  webGLInitialMemorySizeMobile: 32
  webGLMaximumMemorySizeMobile: 2048
  webGLMemoryPinnedSizeMobile: 128
  webGLDecompressionFallbackMobile: 0
  apiCompatibilityLevel: 6
  activeInputHandler: 2
  windowsGamepadBackendHint: 0
  cloudProjectId:
  projectName:
  organizationId:
  cloudEnabled: 0
  legacyClampBlendShapeWeights: 1
  hmiLoadingImage: {fileID: 0}
  platformRequiresReadableAssets: 0
  virtualTexturingSupportEnabled: 0
  insecureHttpOption: 0
