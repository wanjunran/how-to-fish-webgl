%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!129 &1
PlayerSettings:
  m_ObjectHideFlags: 0
  serializedVersion: 26
  productGUID: 8f4b7c2e9a1d4e6fb3c5d7e9f0a2b4c6
  AndroidProfiler: 0
  companyName: DefaultCompany
  productName: How to Fish
  defaultCursor: {fileID: 0}
